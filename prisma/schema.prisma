generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's Vercel integration sets this automatically alongside DATABASE_URL.
  // Prisma Migrate needs a non-pooled connection for its advisory locks.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  MEMBER
}

enum ItemSection {
  STAY
  TRANSPORT
  ACTIVITIES
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  /// A pretend travel buddy in a sample trip; can't sign in.
  isSample     Boolean        @default(false)
  /// When the welcome walkthrough was finished or skipped.
  onboardedAt  DateTime?
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  invitesSent  Invite[]       @relation("InviteCreatedBy")
  oauthCodes   OAuthCode[]
  oauthGrants  OAuthGrant[]
  attending    ItemAttendee[]
  paidExpenses Expense[]      @relation("ExpensePaidBy")
}

model Team {
  id           String       @id @default(cuid())
  name         String
  currency     String       @default("EUR")
  /// A Google Places API key this team supplies for the MCP server's
  /// check_place tool. There's no shared deployment-wide key: without one
  /// set here, check_place can't be used for this team at all. Plain text:
  /// this app has no secrets encryption, the same trade a team accepts by
  /// setting it at all.
  placesApiKey String?
  /// The sample trip seeded at signup, with pretend travel buddies.
  isSample     Boolean      @default(false)
  /// The one shared sample trip an unauthenticated visitor tours at `/`.
  /// Lazily created on first visit (see lib/publicDemo.ts) and never more
  /// than one row - every anonymous visitor sees the same team.
  isPublicDemo Boolean      @default(false)
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  trips        Trip[]
  invites      Invite[]
  placesCalls  PlacesCall[]
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String

  @@unique([userId, teamId])
}

model Invite {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid())
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  createdBy     User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById   String
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  acceptedEmail String?
}

model Trip {
  id        String     @id @default(cuid())
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  label     String
  color     String?
  photoUrl  String?
  /// A city icon chosen by hand (a key in lib/cityIcons, or "pin"); null
  /// picks one from the stop's name.
  icon      String?
  start     DateTime
  end       DateTime
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  items     TripItem[]
  expenses  Expense[]

  @@index([teamId])
}

model TripItem {
  id          String         @id @default(cuid())
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  section     ItemSection
  title       String
  url         String         @default("")
  // When a plan happens: a calendar day at the destination, plus an optional
  // local "HH:mm" time. Kept as wall-clock values so they never shift.
  date        DateTime?      @db.Date
  time        String?
  /// A short note on the plan — booking details, a reminder, anything that
  /// doesn't belong in the title.
  notes       String?
  order       Int            @default(0)
  attachments Attachment[]
  attendees   ItemAttendee[]
  /// What this plan cost - zero, one or several. A booking's own price lives
  /// here as much as a loose cost on an activity does: an item may or may
  /// not have one, and can have more than one (an entry ticket and a taxi
  /// to get there), so it's never a field on the plan itself. See Expense.
  expenses    Expense[]

  @@index([tripId])
}

/// A cost on the trip: an amount, who fronted it, and - optionally - the
/// plan it was for. Its own object rather than fields on TripItem, because a
/// plan can carry none, one or several (a museum ticket and the taxi there
/// are two expenses on one activity), and a cost doesn't always have a plan
/// behind it at all - a tip, a shared snack, cash from an ATM. See
/// lib/balances.ts for how it's split.
model Expense {
  id        String   @id @default(cuid())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId    String
  /// The plan this cost belongs to, if it belongs to one. Cascade, not
  /// SetNull: deleting the plan it was for should take its costs with it,
  /// the same way deleting a stop already takes its plans.
  item      TripItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String?
  title     String
  amount    Float
  /// Who fronted the money, for splitting costs - see lib/balances.ts.
  /// SetNull rather than Cascade: losing track of who paid shouldn't delete
  /// the expense itself.
  paidBy    User?    @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  paidById  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([itemId])
}

/// Someone on the trip who signed up for a plan, so a group can split up:
/// some go to one activity, others to another. Each person signs themselves
/// up.
model ItemAttendee {
  item      TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([itemId, userId])
  @@index([userId])
}

/// A PDF (ticket, confirmation, receipt) attached to a booking. Bytes live in
/// Vercel Blob when BLOB_READ_WRITE_TOKEN is configured (blobUrl), otherwise
/// in Postgres (data). Always served through /api/attachments/[id].
model Attachment {
  id          String   @id @default(cuid())
  item        TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  name        String
  contentType String
  size        Int
  blobUrl     String?
  data        Bytes?
  createdAt   DateTime @default(now())

  @@index([itemId])
}

/// One real check_place call made to Google's Places API, for a team.
/// Append only - a row is never updated, only counted. Two things read it:
/// the monthly count against Google's free tier (see lib/places-usage.ts),
/// and the planner UI polling for "the agent just checked X" to toast while
/// someone has the team's trips open.
model PlacesCall {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  query     String
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

/// An app that connects to the planner over MCP (Claude, ChatGPT and others),
/// registered by the app itself through OAuth dynamic client registration.
/// The id is the OAuth client_id.
model OAuthClient {
  id           String       @id
  name         String
  redirectUris String[]
  /// Set for clients that authenticate with a secret, null for public ones.
  secretHash   String?
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  grants       OAuthGrant[]
}

/// A one time authorization code, handed to the app after the person
/// approves it and swapped for tokens within ten minutes. Only its hash is
/// stored.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

/// One app's access to one person's account. The access and refresh tokens
/// are replaced on every refresh, and deleting the row disconnects the app.
/// Only hashes are stored.
model OAuthGrant {
  id               String      @id @default(cuid())
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  scope            String
  accessHash       String      @unique
  accessExpiresAt  DateTime
  refreshHash      String      @unique
  refreshExpiresAt DateTime
  createdAt        DateTime    @default(now())
  lastUsedAt       DateTime?

  @@index([userId])
}
