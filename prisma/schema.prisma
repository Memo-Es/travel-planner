generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's Vercel integration sets this automatically alongside DATABASE_URL.
  // Prisma Migrate needs a non-pooled connection for its advisory locks.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  MEMBER
}

enum ItemSection {
  STAY
  TRANSPORT
  ACTIVITIES
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  invitesSent  Invite[]     @relation("InviteCreatedBy")
  oauthCodes   OAuthCode[]
  oauthGrants  OAuthGrant[]
}

model Team {
  id          String       @id @default(cuid())
  name        String
  currency    String       @default("EUR")
  createdAt   DateTime     @default(now())
  memberships Membership[]
  trips       Trip[]
  invites     Invite[]
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String

  @@unique([userId, teamId])
}

model Invite {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid())
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  createdBy     User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById   String
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?
  acceptedEmail String?
}

model Trip {
  id        String     @id @default(cuid())
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  label     String
  color     String?
  photoUrl  String?
  start     DateTime
  end       DateTime
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  items     TripItem[]

  @@index([teamId])
}

model TripItem {
  id          String       @id @default(cuid())
  trip        Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  section     ItemSection
  title       String
  url         String       @default("")
  costAmount  Float?
  // When a plan happens: a calendar day at the destination, plus an optional
  // local "HH:mm" time. Kept as wall-clock values so they never shift.
  date        DateTime?    @db.Date
  time        String?
  order       Int          @default(0)
  attachments Attachment[]

  @@index([tripId])
}

/// A PDF (ticket, confirmation, receipt) attached to a booking. Bytes live in
/// Vercel Blob when BLOB_READ_WRITE_TOKEN is configured (blobUrl), otherwise
/// in Postgres (data). Always served through /api/attachments/[id].
model Attachment {
  id          String   @id @default(cuid())
  item        TripItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String
  name        String
  contentType String
  size        Int
  blobUrl     String?
  data        Bytes?
  createdAt   DateTime @default(now())

  @@index([itemId])
}

/// An app that connects to the planner over MCP (Claude, ChatGPT and others),
/// registered by the app itself through OAuth dynamic client registration.
/// The id is the OAuth client_id.
model OAuthClient {
  id           String       @id
  name         String
  redirectUris String[]
  /// Set for clients that authenticate with a secret, null for public ones.
  secretHash   String?
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  grants       OAuthGrant[]
}

/// A one time authorization code, handed to the app after the person
/// approves it and swapped for tokens within ten minutes. Only its hash is
/// stored.
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  redirectUri   String
  codeChallenge String
  scope         String
  resource      String?
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

/// One app's access to one person's account. The access and refresh tokens
/// are replaced on every refresh, and deleting the row disconnects the app.
/// Only hashes are stored.
model OAuthGrant {
  id               String      @id @default(cuid())
  client           OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId         String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  scope            String
  accessHash       String      @unique
  accessExpiresAt  DateTime
  refreshHash      String      @unique
  refreshExpiresAt DateTime
  createdAt        DateTime    @default(now())
  lastUsedAt       DateTime?

  @@index([userId])
}
