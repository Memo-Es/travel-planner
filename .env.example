DATABASE_URL="postgresql://user:password@localhost:5432/travel_planner?schema=public"
# Used by Prisma Migrate for the actual schema-change connection. On Neon
# (e.g. via the Vercel integration) this is set automatically to the
# non-pooled connection string. Locally, without a connection pooler in
# front of your database, it's fine to set this to the same value as
# DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/travel_planner?schema=public"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Optional. When set (connect a Vercel Blob store), PDF attachments are stored
# in Blob; otherwise they are stored in Postgres. Use a private store, or set
# BLOB_ACCESS="public" if the store is public.
# BLOB_READ_WRITE_TOKEN=""
# BLOB_ACCESS="private"
